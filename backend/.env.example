# ==============================================================================
# Enterprise Workflow Automation - Environment Variable Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to .env in your backend directory:
#    cp .env.example .env (Linux/macOS) OR copy .env.example .env (Windows)
# 2. Populate with your environment-specific values.
# 3. NEVER commit your actual .env file or real production credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Required)
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
WORKFLOW_DATABASE_URL=postgresql+psycopg2://db_user:db_password@127.0.0.1:5432/workflow_db
WORKFLOW_DB_SCHEMA=workflow

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Tokens (Required)
# ------------------------------------------------------------------------------
# Generate a strong 256-bit random key:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 3. Credential Encryption - Fernet Symmetric Key (Required)
# ------------------------------------------------------------------------------
# Generate a standard Fernet key:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: Existing encrypted credentials (e.g. stored database passwords) require
# the matching Fernet key to decrypt. Do not rotate without an approved migration plan.
FERNET_KEY=replace_with_a_valid_base64_encoded_32_byte_fernet_key=

# ------------------------------------------------------------------------------
# 4. Networking & CORS Configuration (Optional)
# ------------------------------------------------------------------------------
MAIN_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 5. Monitoring & Observability Credentials (Required for Docker Compose)
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_secure_grafana_password
