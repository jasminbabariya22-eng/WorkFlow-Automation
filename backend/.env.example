# ==========================================
# Workflow Automation Environment Template
# ==========================================

# PostgreSQL Connection for Workflow Engine
WORKFLOW_DATABASE_URL=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# Security Secrets (Generate using openssl or python secrets.token_hex(32))
SECRET_KEY=your_secure_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Schema & Encryption
WORKFLOW_DB_SCHEMA=workflow
FERNET_KEY=your_fernet_encryption_key_here

# Frontend Application URL
MAIN_URL=http://localhost:5173
